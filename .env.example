# ==============================================================
# CẤU HÌNH HỆ THỐNG NHẬN DIỆN KHUÔN MẶT TẦNG BIÊN (PI 4)
# ==============================================================

# --- 1. CHẾ ĐỘ HOẠT ĐỘNG ---
# ENABLE_PAD=true  : Chế độ CÓ PAD (Bảo mật cao, kiểm tra liveness chống giả mạo)
# ENABLE_PAD=false : Chế độ KHÔNG PAD
ENABLE_PAD=true

# --- 2. CẤU HÌNH WEBCAM & MÔ HÌNH AI ---
# CAMERA_INDEX : Cổng USB Webcam (mặc định 0 cho /dev/video0)
CAMERA_INDEX=0

# MATCH_THRESHOLD : Ngưỡng nhận diện ArcFace (0.35 đến 0.42)
MATCH_THRESHOLD=0.40

# FAS_MODEL_PATH : Đường dẫn model Anti-Spoofing (mặc định: models/R7_SC_100K_crop15.onnx)
FAS_MODEL_PATH=models/R7_SC_100K_crop15.onnx

# FAS_LOGIT_THRESHOLD : Ngưỡng logit phân định Real/Spoof (pad_score = logits[0] - logits[1])
FAS_LOGIT_THRESHOLD=-0.3730

# --- 3. CẤU HÌNH HỆ THỐNG KIỂM SOÁT CỬA (SIÊU ÂM + SERVO + 2 LED) ---
# Cảm biến siêu âm HC-SR04:
ULTRASONIC_TRIG_PIN=23
ULTRASONIC_ECHO_PIN=24
OBSTACLE_DISTANCE_CM=40.0

# Động cơ Servo (SG90 / MG90S) mở cửa 90 độ:
SERVO_PIN=18
DOOR_HOLD_SECONDS=3.0

# Đèn LED chỉ thị:
# - Giả mạo (Spoof) -> Bật đèn Đỏ
# - Người thật nhưng không có trong CSDL (Unknown) -> Bật đèn Xanh
# - Nhận diện đúng người trong CSDL -> Mở Servo 90 độ
LED_RED_PIN=27
LED_GREEN_PIN=17

# --- 4. SƠ ĐỒ CHÂN MA TRẬN 10 LED CŨ (NẾU DÙNG LED MATRIX) ---
LED_RED_PINS=27,22,23,25,16
LED_GREEN_PINS=17,18,24,12,26
