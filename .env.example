# ==============================================================
# CẤU HÌNH HỆ THỐNG NHẬN DIỆN KHUÔN MẶT TẦNG BIÊN (PI 4)
# ==============================================================

# --- 1. CHẾ ĐỘ HOẠT ĐỘNG ---
# ENABLE_PAD=true  : Chế độ CÓ PAD (Bảo mật cao, kiểm tra liveness, tối đa 5 mặt)
# ENABLE_PAD=false : Chế độ KHÔNG PAD (Tốc độ cao 20-25 FPS, đếm số người bằng LED)
ENABLE_PAD=true

# --- 2. CẤU HÌNH WEBCAM & MÔ HÌNH AI ---
# CAMERA_INDEX : Cổng USB Webcam (mặc định 0 cho /dev/video0)
CAMERA_INDEX=0

# MATCH_THRESHOLD : Ngưỡng nhận diện ArcFace (0.60 - 0.68, mặc định 0.62)
MATCH_THRESHOLD=0.62

# FAS_LOGIT_THRESHOLD : Ngưỡng logit phân định Real/Spoof cho MiniFASNet R7 (pad_score = logits[0] - logits[1])
#   -4.9000 : (Mặc định chuẩn) Điểm cắt tối ưu phân tách giữa mặt thật (d >= -4.70 -> REAL) và điện thoại (d <= -5.09 -> SPOOF)
#   -4.2998 : Chuẩn CASIA lý thuyết (khắt khe hơn với mặt thật)
FAS_LOGIT_THRESHOLD=-4.90

# --- 3. SƠ ĐỒ CHÂN GPIO MA TRẬN 10 LED (GPIOZERO) ---
# Danh sách 5 chân GPIO (BCM) cho Hàng LED Đỏ (Cột 1 đến Cột 5)
LED_RED_PINS=27,22,23,25,16

# Danh sách 5 chân GPIO (BCM) cho Hàng LED Xanh (Cột 1 đến Cột 5)
LED_GREEN_PINS=17,18,24,12,26
