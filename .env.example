# ==============================================================
# CẤU HÌNH HỆ THỐNG NHẬN DIỆN KHUÔN MẶT TẦNG BIÊN (PI 4)
# ==============================================================

# --- 1. CHẾ ĐỘ HOẠT ĐỘNG ---
# ENABLE_PAD=true  : Chế độ CÓ PAD (Bảo mật cao, kiểm tra liveness, tối đa 5 mặt)
# ENABLE_PAD=false : Chế độ KHÔNG PAD (Tốc độ cao 20-25 FPS, đếm số người bằng LED)
ENABLE_PAD=true

# --- 2. CẤU HÌNH WEBCAM & MÔ HÌNH AI ---
# CAMERA_INDEX : Cổng USB Webcam (mặc định 0 cho /dev/video0)
CAMERA_INDEX=0

# MATCH_THRESHOLD : Ngưỡng nhận diện ArcFace (0.35 đến 0.42)
MATCH_THRESHOLD=0.40

# FAS_MODEL_PATH : Đường dẫn model Anti-Spoofing (mặc định: models/R7_SC_100K_crop15.onnx)
FAS_MODEL_PATH=models/R7_SC_100K_crop15.onnx
# FAS_MODEL_PATH=models/R7_SC_FULL_crop15.onnx

# FAS_LOGIT_THRESHOLD : Ngưỡng logit phân định Real/Spoof (pad_score = logits[0] - logits[1])
# --- Nhóm 1: Dành cho Model 100K (R7_SC_100K_crop15.onnx) ---
# FAS_LOGIT_THRESHOLD=-4.2998         # Điểm cắt lý thuyết tối ưu hóa chỉ số lỗi ACER/HTER trên tập benchmark quốc tế CASIA-FASD
# FAS_LOGIT_THRESHOLD=-4.9000       # Thực nghiệm phân tách tối ưu: Real (>= -4.70), Phone (<= -5.09)
FAS_LOGIT_THRESHOLD=-0.3730       # Ngưỡng nghiệm thu kiểm thử trên tập Val15K

# --- Nhóm 2: Dành cho Model FULL (R7_SC_FULL_crop15.onnx) ---
# FAS_LOGIT_THRESHOLD=1.6587        # Chuẩn CASIA TRAIN (tối ưu ACER/HTER cho model FULL)
# FAS_LOGIT_THRESHOLD=4.6626        # Ngưỡng nghiệm thu chính thức trên tập CelebA Test

# --- 3. SƠ ĐỒ CHÂN GPIO MA TRẬN 10 LED (GPIOZERO) ---
# Danh sách 5 chân GPIO (BCM) cho Hàng LED Đỏ (Cột 1 đến Cột 5)
LED_RED_PINS=27,22,23,25,16

# Danh sách 5 chân GPIO (BCM) cho Hàng LED Xanh (Cột 1 đến Cột 5)
LED_GREEN_PINS=17,18,24,12,26
